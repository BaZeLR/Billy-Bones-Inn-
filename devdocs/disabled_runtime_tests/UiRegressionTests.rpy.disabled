    testcase player_effective_exploration_uses_dog_bonus_and_updates_card_description:
        run Jump("UITestBootGame")
        $ exploration = 50
        $ dog.owned = True
        $ update_stat_state()
        $ _effective_exploration = effective_player_exploration()
        $ _player_card_lines = player_card_body_lines()
        python:
            _has_tracker_line = False
            for _line in list(_player_card_lines or []):
                _line_text = str(_line or "").lower()
                if "следопыт" in _line_text or "охотник" in _line_text:
                    _has_tracker_line = True
                    break
        assert eval (int(_effective_exploration or 0) == 75)
        assert eval (_has_tracker_line)

    testcase player_card_mentions_equipped_rifle_and_cuirass:
        run Jump("UITestBootGame")
        $ _player_add_item_by_id("rusty_hunter_rifle_001", 1)
        $ _player_add_item_by_id("old_leather_cuirass_001", 1)
        $ EquippedWeapon = "rusty_hunter_rifle_001"
        $ EquippedArmor = "old_leather_cuirass_001"
        $ _player_card_lines = player_card_body_lines()
        python:
            _has_rifle_line = False
            _has_cuirass_line = False
            for _line in list(_player_card_lines or []):
                _line_text = str(_line or "").lower()
                if "винтов" in _line_text:
                    _has_rifle_line = True
                if "кирас" in _line_text:
                    _has_cuirass_line = True
        assert eval (_has_rifle_line)
        assert eval (_has_cuirass_line)

