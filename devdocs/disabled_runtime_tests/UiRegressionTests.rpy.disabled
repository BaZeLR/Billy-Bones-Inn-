        assert eval (int(_weekly_preview.get("sandra_friend", 0) or 0) == 9)

    testcase weekly_chores_do_not_eval_on_saturday_morning:
        $ _weekly_target_state = {key: player_chore_target(key) for key in PLAYER_CHORE_KEYS}
        $ _weekly_preview = weekly_chores_evaluation_preview(6, 0, 1100, 1, 1, "", _weekly_target_state, {"sum": 24, "days": 6, "prev_avg": 2.0}, 9, {"MCVisitFirstReady": 0, "MCVisitFirstPending": 0}, {"amanda": 2, "melissa": 1})
