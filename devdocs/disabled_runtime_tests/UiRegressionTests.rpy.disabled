    testcase player_look_is_derived_from_dress_haircut_hygiene:
        $ MyCurDress = "villagedress"
        $ PlayerDressDaySt = {"villagedress": int(dayspassed or 0)}
        $ PlayerHaircutDaySt = int(dayspassed or 0)
        $ dayssincewash = 0
        $ update_stat_state()
        assert eval (int(look or 0) == 80)
        $ dayssincewash = 5
        $ update_stat_state()
        assert eval (int(look or 0) == 50)
        $ dayssincewash = 0
        $ PlayerHaircutDaySt = int(dayspassed or 0) - 26
        $ update_stat_state()
        assert eval (int(look or 0) == 25)
        $ MyCurDress = "nobbledress"
        $ PlayerDressDaySt["nobbledress"] = int(dayspassed or 0)
        $ update_stat_state()
        assert eval (int(look or 0) == 70)
        $ PlayerHaircutDaySt = int(dayspassed or 0)
        $ PlayerDressDaySt["nobbledress"] = int(dayspassed or 0) - 42
        $ update_stat_state()
        assert eval (int(look or 0) == 30)

    testcase player_haircut_due_day_tracks_last_haircut_plus_25_days:
        run Jump("UITestBootGame")
        $ dayspassed = 12
        $ PlayerHaircutDaySt = 12
        assert eval (int(player_haircut_due_day() or 0) == 37)
        $ PlayerHaircutDaySt = 12
        assert eval (int(player_haircut_look_value(25) or 0) == 15)
        assert eval (int(player_haircut_look_value(26) or 0) == -40)

    testcase barber_shop_schedule_and_haircut_work:
        run Jump("UITestSetupBarberShopMondayAfternoon")
        pause until screen "main_ui"
        assert eval (str(CurLoc or "") == "BarberShop")
        assert eval (any("Подстричься" in str(getattr(item, "caption", "") or "") for item in current_action_items))
        $ money = 100
        $ dayspassed = 10
        $ PlayerHaircutDaySt = int(dayspassed or 0) - 40
        run Call("BarberShopHaircut")
        assert eval (int(money or 0) == 10)
        assert eval (int(PlayerHaircutDaySt or 0) == int(dayspassed or 0))
        assert eval (int(player_haircut_due_day() or 0) == int(dayspassed or 0) + 25)
        assert eval (int(player_haircut_elapsed_days() or 0) == 0)
        run Jump("UITestSetupBarberShopTuesdayMorning")
        pause until screen "main_ui"
        assert eval ("закрыт" in str(MainTxt or "").lower() or "прикрыты" in str(MainTxt or "").lower())
        assert eval (all("Подстричься" not in str(getattr(item, "caption", "") or "") for item in current_action_items))
        run Jump("UITestSetupBarberShopSaturdayMorning")
        pause until screen "main_ui"
        assert eval (any("Подстричься" in str(getattr(item, "caption", "") or "") for item in current_action_items))

