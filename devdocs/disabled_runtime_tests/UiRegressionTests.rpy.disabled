    testcase my_room_table_can_craft_soap_and_switch_to_backyard_picture:
        run Jump("UITestBootGame")
        $ playerItems = {"recipe_book_001": 1, "night_bowl_001": 1, "pig_lard_001": 1, "lavender_001": 1}
        $ SoapAshBarrelInstalled = 1
        $ SoapAshBarrelReadyDay = 0
