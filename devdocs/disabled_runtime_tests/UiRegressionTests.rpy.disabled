        $ dog = DogCompanion()
        $ dog.owned = True
        $ dog.loyalty = 5
        $ MyStallion = "Вороной"
        $ StolenHorseDays = 0
        $ MongolVar["WillTryToSteal"] = 1
        $ MongolVar["TheftAsk"] = 1
        $ MongolVar["AskSawStolen"] = 1
        $ MongolVar["SawStolen"] = 1
        $ ZimmerVar["ComplainHorse"] = 1
        $ money = 0
        $ tavernfame = 0
        $ notoriety = 0
        $ Friends["sandra"] = 0
        $ Friends["melissa"] = 0
        $ Friends["amanda"] = 0
        run Call("NextDay_TavernDaily")
        assert eval (str(MyStallion or "") == "Вороной")
        assert eval (int(StolenHorseDays or 0) == 0)
        assert eval (int(MongolVar.get("WillTryToSteal", 0) or 0) == 0)
        assert eval (int(MongolVar.get("TheftAsk", 0) or 0) == 0)
        assert eval (int(MongolVar.get("AskSawStolen", 0) or 0) == 0)
        assert eval (int(MongolVar.get("SawStolen", 0) or 0) == 0)
        assert eval (int(ZimmerVar.get("ComplainHorse", 0) or 0) == 0)
        assert eval ("пес" in str(TotalDay.get("HorseStolen", "") or "").lower())
        assert eval (int(money or 0) > 0)
        assert eval (int(tavernfame or 0) == 2)
        assert eval (int(notoriety or 0) == 3)
        assert eval (int(Friends.get("sandra", 0) or 0) == 2)
        assert eval (int(Friends.get("melissa", 0) or 0) == 2)
        assert eval (int(Friends.get("amanda", 0) or 0) == 2)

