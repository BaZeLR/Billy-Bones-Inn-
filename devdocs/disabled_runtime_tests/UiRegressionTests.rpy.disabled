    testcase weekly_chores_eval_on_sunday_night:
        $ _weekly_target_state = {key: player_chore_target(key) for key in PLAYER_CHORE_KEYS}
        $ _weekly_preview = weekly_chores_evaluation_preview(7, 4, 1100, 1, 7, "", _weekly_target_state, {"sum": 24, "days": 6, "prev_avg": 2.0}, 9, {"MCVisitFirstReady": 0, "MCVisitFirstPending": 0}, {"amanda": 2, "melissa": 1})
        assert eval (bool(_weekly_preview.get("applied", False)))
        assert eval ("Сандра заметила" in str(_weekly_preview.get("message", "") or ""))
        assert eval (int(_weekly_preview.get("sandra_friend", 0) or 0) >= 10)
        assert eval (int(dict(_weekly_preview.get("sandra_flags", {}) or {}).get("MCVisitFirstPending", 0) or 0) == 1)
        assert eval (all(int(dict(_weekly_preview.get("chores", {}) or {}).get(key, 0) or 0) == 0 for key in PLAYER_CHORE_KEYS))

    testcase weekly_chores_eval_on_sunday_evening_before_sleep:
        $ _weekly_target_state = {key: player_chore_target(key) for key in PLAYER_CHORE_KEYS}
        $ _weekly_preview = weekly_chores_evaluation_preview(7, 3, 1100, 1, 7, "", _weekly_target_state, {"sum": 24, "days": 6, "prev_avg": 2.0}, 9, {"MCVisitFirstReady": 0, "MCVisitFirstPending": 0}, {"amanda": 2, "melissa": 1})
        assert eval (bool(_weekly_preview.get("applied", False)))
        assert eval (int(_weekly_preview.get("sandra_friend", 0) or 0) >= 10)
        assert eval (int(dict(_weekly_preview.get("sandra_flags", {}) or {}).get("WeeklyChoreCheckScore", 0) or 0) == len(PLAYER_CHORE_KEYS))
        assert eval (all(int(dict(_weekly_preview.get("chores", {}) or {}).get(key, 0) or 0) == 0 for key in PLAYER_CHORE_KEYS))

    testcase weekly_chores_do_not_eval_on_sunday_after_midnight:
        $ _weekly_target_state = {key: player_chore_target(key) for key in PLAYER_CHORE_KEYS}
        $ _weekly_preview = weekly_chores_evaluation_preview(7, 4, 1100, 1, 7, "", _weekly_target_state, {"sum": 24, "days": 6, "prev_avg": 2.0}, 9, {"MCVisitFirstReady": 0, "MCVisitFirstPending": 0}, {"amanda": 2, "melissa": 1}, 1)
