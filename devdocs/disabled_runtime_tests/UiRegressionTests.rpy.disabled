        assert eval (str(CurLoc or "") == "TavernMyRoom")
        assert eval (str(_layout_last_picture or "") == "images/player_room/wake_up_2.png")

        click "Кухня"
        pause until screen "main_ui"
        assert eval (str(CurLoc or "") == "TavernKitchen")

        click "Во двор"
        pause until screen "main_ui"
        assert eval (str(CurLoc or "") == "Backyard")

        click "Сарай"
        pause until screen "main_ui"
        assert eval (str(CurLoc or "") == "Shed")

        $ hour = 8
        $ minute = 0
        $ time = 0
        $ calendar_sync_state()
        click "Сходить в лес за бревнами"
        pause until screen "main_ui"
        assert eval (str(CurLoc or "") == "Forest")

        click "Пойти к озеру"
        pause until screen "main_ui"
        assert eval (str(CurLoc or "") == "ForestLake")

        $ _fun_before = int(fun or 0)
        click "Искупаться в озере"
        pause until screen "main_ui"
        assert eval (int(dayssincewash or 0) == 0)
        assert eval (int(fun or 0) >= _fun_before)

