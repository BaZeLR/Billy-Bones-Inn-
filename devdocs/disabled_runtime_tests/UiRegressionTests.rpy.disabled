    testcase weekly_chores_store_sandra_score_counter_and_week5_wake_flag:
        $ _weekly_target_state = {key: 0 for key in PLAYER_CHORE_KEYS}
        $ _weekly_target_state["bring_woods"] = player_chore_target("bring_woods")
        $ _weekly_target_state["chop_wood"] = player_chore_target("chop_wood")
        $ _weekly_target_state["make_fire"] = player_chore_target("make_fire")
        $ _weekly_target_state["clean_ashes"] = player_chore_target("clean_ashes")
        $ _weekly_preview = weekly_chores_evaluation_preview(7, 4, 1100, 1, 7, "", _weekly_target_state, {"sum": 0, "days": 0, "prev_avg": 0.0}, 7, {"WeeklyChoreCheckCounter": 0, "Week5WakePending": 0}, {"amanda": 0, "melissa": 0})
        $ _weekly_flags = dict(_weekly_preview.get("sandra_flags", {}) or {})
        assert eval (bool(_weekly_preview.get("applied", False)))
        assert eval (int(_weekly_flags.get("WeeklyChoreCheckScore", 0) or 0) == 4)
        assert eval (int(_weekly_flags.get("WeeklyChoreCheckCounter", 0) or 0) == 1)
        assert eval (int(_weekly_flags.get("Week5WakePending", 0) or 0) == 1)
        assert eval (str(_weekly_flags.get("WeeklyChoreCheckEval", "") or "") == "neutral")

    testcase weekly_chores_below_four_clear_week5_wake_flag:
        $ _weekly_target_state = {key: 0 for key in PLAYER_CHORE_KEYS}
        $ _weekly_target_state["bring_woods"] = player_chore_target("bring_woods")
        $ _weekly_target_state["chop_wood"] = player_chore_target("chop_wood")
        $ _weekly_target_state["make_fire"] = player_chore_target("make_fire")
        $ _weekly_preview = weekly_chores_evaluation_preview(7, 4, 1100, 1, 7, "", _weekly_target_state, {"sum": 0, "days": 0, "prev_avg": 0.0}, 7, {"WeeklyChoreCheckCounter": 2, "Week5WakePending": 1}, {"amanda": 0, "melissa": 0})
        $ _weekly_flags = dict(_weekly_preview.get("sandra_flags", {}) or {})
        assert eval (int(_weekly_flags.get("WeeklyChoreCheckScore", 0) or 0) == 3)
        assert eval (int(_weekly_flags.get("WeeklyChoreCheckCounter", 0) or 0) == 2)
        assert eval (int(_weekly_flags.get("Week5WakePending", 0) or 0) == 0)
        assert eval (str(_weekly_flags.get("WeeklyChoreCheckEval", "") or "") == "neutral")

    testcase weekly_chores_low_score_marks_bad_evaluation:
