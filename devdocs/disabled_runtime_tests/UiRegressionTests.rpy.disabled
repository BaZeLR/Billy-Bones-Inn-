label UITestDailyEventSink(girl_name="", cur_loc_arg=""):
    $ UITestLastDailyEventGirl = str(girl_name or "")
    $ UITestLastDailyEventLoc = str(cur_loc_arg or "")
    return

label UITestDailyEventSinkOne(girl_name=""):
    $ UITestLastDailyEventGirl = str(girl_name or "")
    $ UITestLastDailyEventLoc = "__one_arg__"
    return

label UITestDailyEventSinkZero():
    $ UITestLastDailyEventGirl = "__zero_arg__"
    $ UITestLastDailyEventLoc = "__zero_arg__"
    return
    call InitLiza
    call InitBecky
    call InitInga
    call InitIrma
    call InitClara

    python:
        for _intro_girl_name in AllGirlNames:
            topraised[_intro_girl_name] = 0
            bottomraised[_intro_girl_name] = 0
