            jobcleaningtomorrow[_intro_girl_name] = int(jobcleaning.get(_intro_girl_name, 0) or 0)
            jobwaitresstomorrow[_intro_girl_name] = int(jobwaitress.get(_intro_girl_name, 0) or 0)
            LickPussy[_intro_girl_name] = 0
