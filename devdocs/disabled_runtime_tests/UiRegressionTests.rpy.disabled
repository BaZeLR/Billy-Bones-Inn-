        run Jump("UITestBootGame")
        $ playerItems = {"rusty_hunter_rifle_001": 1, "weapon_oil_001": 1, "droplets_001": 1, "gunpowder_001": 1}
        $ RustyHunterRifleLoadedAmmo = ""
