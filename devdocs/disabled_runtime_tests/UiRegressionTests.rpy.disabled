    jump Backyard


testsuite ui_regressions:
    before testcase:
        run Jump("UITestBootGame")
        pause until screen "main_ui"

    teardown:
        exit

    testcase time_overlay_roundtrip:
        assert eval (CurLoc == "TavernMain")
        click "Время"
        pause until screen "time_change_card_overlay"
        click "Назад"
        pause until not screen "time_change_card_overlay"
        assert screen "main_ui"
        assert eval (CurLoc == "TavernMain")

    testcase player_card_roundtrip:
        $ show_player_card_main_ui_state()
        assert eval (str(UI_mode or "") == "mc")
        assert eval (str(current_action_title or "") == "Стефан")
        $ main_ui_restore_room_scene_state()
        assert eval (str(UI_mode or "") == "scene")
        assert screen "main_ui"

    testcase player_card_inventory_menu_shows_stackable_counts:
        run Jump("UITestBootGame")
        $ playerItems = {"berries_001": 3, "mushroom_001": 2}
        $ show_player_card_main_ui_state()
        assert eval (any(str(getattr(item, "caption", "") or "") == "Проверить вещи" for item in current_action_items))
        run Call("PlayerCardInventoryMenu")
        assert eval (str(UI_mode or "") == "mc")
        assert eval (str(current_action_title or "") == "Вещи")
        assert eval (any(str(getattr(item, "caption", "") or "") == "ягоды x3" for item in current_action_items))
        assert eval (any(str(getattr(item, "caption", "") or "") == "грибы x2" for item in current_action_items))

    testcase player_card_can_eat_berries_from_item_actions:
        run Jump("UITestBootGame")
        $ playerItems = {"berries_001": 3}
        $ energy = 20
        $ fun = 10
        $ show_player_card_main_ui_state()
        run Call("PlayerCardInventoryItemMenu", "berries_001")
        assert eval (any(str(getattr(item, "caption", "") or "") == "Съесть ягоды" for item in current_action_items))
        run Call("UseBerriesItem")
        assert eval (int(_player_item_count_by_id("berries_001") or 0) == 2)
        assert eval (int(energy or 0) == 25)
        assert eval (int(fun or 0) == 13)
        assert eval ("ягод" in str(MainTxt or "").lower())
        assert eval (any(str(getattr(item, "caption", "") or "") == "Съесть ягоды" for item in current_action_items))

    testcase player_card_can_drink_ale_and_get_empty_bottle_and_cork:
        run Jump("UITestBootGame")
        $ playerItems = {"drink_ale_001": 1}
        $ energy = 20
        $ fun = 10
        $ show_player_card_main_ui_state()
        run Call("PlayerCardInventoryItemMenu", "drink_ale_001")
        assert eval (any(str(getattr(item, "caption", "") or "") == "Выпить эль" for item in current_action_items))
        run Call("UseAleItem")
        assert eval (int(_player_item_count_by_id("drink_ale_001") or 0) == 0)
        assert eval (int(_player_item_count_by_id("empty_bottle_001") or 0) == 1)
        assert eval (int(_player_item_count_by_id("cork_001") or 0) == 1)
        assert eval (int(energy or 0) == 30)
        assert eval (int(fun or 0) == 15)
        assert eval ("пустая бутылка" in str(MainTxt or "").lower())
        assert eval (str(current_action_title or "") == "Вещи")
        assert eval (any(str(getattr(item, "caption", "") or "") == "пустая бутылка" for item in current_action_items))
        assert eval (any(str(getattr(item, "caption", "") or "") == "пробка" for item in current_action_items))

    testcase save_smoke_after_grocery_object_menu_does_not_pickle_runtime_objects:
        run Jump("UITestBootGame")
        $ time = 1
        run Jump("GroceryStore")
        pause until screen "main_ui"
        click "Провизия"
        pause until screen "main_ui"
        $ renpy.save("_codex_grocery_pickle_smoke", "codex grocery pickle smoke")
        assert eval (True)

    testcase save_smoke_with_lumber_item_registry_does_not_pickle_item_conditions:
        run Jump("UITestBootGame")
        $ playerItems = {"lumber_001": 1}
        $ show_player_card_main_ui_state()
        run Call("PlayerCardInventoryItemMenu", "lumber_001")
        pause until screen "main_ui"
        $ renpy.save("_codex_lumber_pickle_smoke", "codex lumber pickle smoke")
        assert eval (True)

    testcase save_smoke_after_ui_translation_helper_does_not_replace_store_underscore:
        run Jump("UITestBootGame")
        $ ensure_ui_translation_callable()
        $ renpy.save("_codex_ui_translation_pickle_smoke", "codex ui translation pickle smoke")
        assert eval (callable(globals().get("_", None)))

    testcase ui_translation_repair_restores_callable_when_store_underscore_missing:
        run Jump("UITestBootGame")
        python:
            import renpy.store as store
            store._ = None
            repair_store_translation_callable()
        assert eval (callable(globals().get("_", None)))
        $ renpy.save("_codex_ui_translation_repair_smoke", "codex ui translation repair smoke")
        assert eval (True)

    testcase guarded_save_repairs_poisoned_store_translation_callable:
        run Jump("UITestBootGame")
        python:
            import renpy.store as store
            store._ = ui_tr
        $ renpy.save("_codex_guarded_translation_pickle_smoke", "codex guarded translation pickle smoke")
        assert eval (callable(globals().get("_", None)))

    testcase guarded_save_preserves_runtime_store_translation_identity:
        run Jump("UITestBootGame")
        python:
            import renpy.store as store
            store._saved_translation_identity = store._
            def _(text):
                return ui_tr(text)
            store._ = _
        $ renpy.save("_codex_guarded_translation_identity_smoke", "codex guarded translation identity smoke")
        assert eval (renpy.store._ is renpy.store._saved_translation_identity)
        $ renpy.store.__dict__.pop("_saved_translation_identity", None)

    testcase player_card_giftable_item_shows_gift_action:
        run Jump("UITestBootGame")
        $ playerItems = {"soap_001": 1}
        $ show_player_card_main_ui_state()
        run Call("PlayerCardInventoryItemMenu", "soap_001")
        assert eval (any(str(getattr(item, "caption", "") or "") == "Подарить" for item in current_action_items))

    testcase player_card_can_gift_libido_tincture_and_raise_clara_trust:
        run Jump("UITestBootGame")
        $ playerItems = {"libido_tincture_001": 1}
        $ Friends["clara"] = 5
        $ GiftedToday["clara"] = 0
        $ ClaraVar["trust"] = 0
        $ fun = 10
        $ otkroven["clara"] = 0
        $ show_player_card_main_ui_state()
        run Call("PlayerCardGiftItemTo", "libido_tincture_001", "clara")
        assert eval (int(_player_item_count_by_id("libido_tincture_001") or 0) == 0)
        assert eval (int(Friends.get("clara", 0) or 0) >= 6)
        assert eval (int(ClaraVar.get("trust", 0) or 0) == 1)
        assert eval (int(fun or 0) == 13)
        assert eval ("кларисса" in str(MainTxt or "").lower())

    testcase player_card_rifle_uses_clean_name_after_cleaning_and_oiling:
        run Jump("UITestBootGame")
        $ playerItems = {"rusty_hunter_rifle_001": 1}
        $ _rifle = get_game_item("rusty_hunter_rifle_001")
        $ _rifle.state = {"rust_cleaned": 1, "oiled": 1}
        run Call("PlayerCardInventoryMenu")
        assert eval (any(str(getattr(item, "caption", "") or "") == "охотничья винтовка-арбалет" for item in current_action_items))
        run Call("PlayerCardInventoryItemMenu", "rusty_hunter_rifle_001")
        assert eval (str(current_action_title or "") == "охотничья винтовка-арбалет")
        assert eval ("не ржавый трофей" in str(MainTxt or "").lower())

    testcase player_card_rifle_can_load_arrows_and_droplets:
        run Jump("UITestBootGame")
        $ playerItems = {"rusty_hunter_rifle_001": 1, "droplets_001": 1, "gunpowder_001": 1, "arrows_001": 1}
        $ _rifle = get_game_item("rusty_hunter_rifle_001")
        $ _rifle.state = {"rust_cleaned": 1, "oiled": 1}
        $ RustyHunterRifleLoadedAmmo = ""
        run Call("PlayerCardInventoryItemMenu", "rusty_hunter_rifle_001")
        assert eval (any(str(getattr(item, "caption", "") or "") == "Зарядить стрелой" for item in current_action_items))
        assert eval (any(str(getattr(item, "caption", "") or "") == "Зарядить дробью" for item in current_action_items))
        run Call("PlayerCardRifleLoadAmmo", "arrows")
        assert eval (str(RustyHunterRifleLoadedAmmo or "") == "arrows")
        assert eval (int(_player_item_count_by_id("arrows_001") or 0) == 0)
        run Call("PlayerCardRifleUnload")
        assert eval (str(RustyHunterRifleLoadedAmmo or "") == "")
        run Call("PlayerCardRifleLoadAmmo", "droplets")
        assert eval (str(RustyHunterRifleLoadedAmmo or "") == "droplets")
        assert eval (int(_player_item_count_by_id("droplets_001") or 0) == 0)
        assert eval (int(_player_item_count_by_id("gunpowder_001") or 0) == 0)

    testcase attic_inventory_uses_clean_rifle_name_after_service:
        run Jump("UITestBootGame")
        $ playerItems = {"rusty_hunter_rifle_001": 1}
        $ _rifle = get_game_item("rusty_hunter_rifle_001")
