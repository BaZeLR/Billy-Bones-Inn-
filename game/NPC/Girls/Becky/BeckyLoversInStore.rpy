# ================================================================================
# Becky lovers event in the grocery store.
# Uses the existing TodaySexEvents table directly.
# ================================================================================

label BeckyLoversInStore:
    show screen main_ui
    if CheckIfSexEventExist("becky", 99, "StoreLover") > 0 and procedural_randint(1, 3, "becky_store_lover_%s" % int(dayspassed or 0)) == 1:
        $ BeckyStoreSexType = GetSexEventFromTable("becky", 99, "StoreLover")
        $ ChooseOption = 0
        if Becky.store_lover_modest_reaction():
            $ ChooseOption = 1

        if BeckyStoreSexType == 1:
            "Зайдя в лавку вы никого в ней не нашли. Однако прислушавшись, вы услышали стоны, раздающиеся из-за прикрытой двери на склад. Осторожно подойдя к ней, вы увидели месье Легаре, сношающего вдову. Скрип двери привлек его внимание и он, как ни в чем не бывало, поприветствовал вас."
            if ChooseOption == 1:
                "Реакция же Бекки была более бурной. Оттолкнув от себя месье, она одернула платье и строго ему выговорила: \"Как вам не стыдно месье! Воспользовались моей минутной слабостью.\""
                "Обернувшись к вам она сказала: \"Это совсем не то, что ты подумал, Стефан,\" - и гордо прошествовала обратно за прилавок. Альбер усмехнулся и направился к выходу."
            else:
                "Бекки тоже не смутилась и, продолжая отдаваться Альберу, промолвила: \"Ох, Стефан, не устояла я, ведь Альбер мужчина видный, а я девушка одинокая и беззащитная. Но это только один разочек.\""
                "Слова Бекки про один разочек почему-то вызвали усмешку у месье Легаре. Будучи человеком вежливым, вы вернулись обратно в лавку. Вскоре очередной особо громкий стон возвестил о том, что любовники закончили и Бекки вернулась на свое место, на ходу поправляя одежду."
                call PregnancyCheck("becky", "inside", 1, "Легаре")

        elif BeckyStoreSexType == 2:
            $ GruzchikName = RandomNameCode("Male", "German")
            "Зайдя в лавку вы никого в ней не нашли, но ваше внимание привлекла открытая дверь на склад. Недолго думая, вы вошли в нее и вашим глазам открылась интересная картина: здоровенный грузчик безжалостно трахал бедную вдову."
            "Вы уже было собрались кинуться на ее защиту, как вдруг несчастная прошептала: \"О да, [GruzchikName] еще сильнее, глубже!\""
            "Решив им не мешать, вы вернулись обратно в лавку. Вскоре Бекки вернулась со склада, на ходу поправляя одежду."
            if ChooseOption == 1:
                "Увидев вас, она немного смутилась и сказала: \"Ой я и не знала что у нас посетители. Мы там с переставляли ящики.\""
            else:
                $ GruzchikGirl = RandomNameCode("Female", "German")
                "Увидев вас, она сказала: \"Представляешь, [GruzchikGirl] одолжила мне своего грузчика. И не наврала, он хорош. Ты конечно тоже неплох, но захаживаешь ко мне не столь часто, как хотелось бы, а мне ведь внимание нужно.\""
            call PregnancyCheck("becky", "inside", 1, GruzchikName, 1, "Неизвестный грузчик")

        elif BeckyStoreSexType == 3:
            if ChooseOption == 1:
                "Стоило вам зайти в лавку, как миссис Блэнкеншип резко дернулась, одной рукой одергивая платье. \"Ой, Стефан, извини, замечаталась,\" - сказала вдова, пряча за спиной что-то зеленоватое и продолговатое."
                "Как вы ни старались, рассмотреть данный предмет вам не удалось. Пожав плечами, вы продолжили рассматривать товары."
            else:
                "Стоило вам зайти в лавку, как миссис Блэнкеншип резко дернулась, но, увидев вас, вернулась к прежнему занятию. Вдова развалясь сидела на стуле, ее платье было задрано, нижнее белье отсутствовало и она орудовала у себя между ног большим огурцом."
                "Ребекка целиком сосредоточилась на своих ощущениях, игнорируя вас. Еще пара минут - и волна оргазма прошла по ее телу, она вытащила огурец, одернула платье и сказала: \"Ох, Стефанчик, одинокой девушке нужно порой и расслабиться. Так зачем ты приходил?\""
                "Вы начали выбирать еду для трактира, но огурец продолжал занимать ваши мысли. Вы запомнили куда его положила вдова, чтобы при покупке его случайно не купить. Или наоборот, стоит купить именно его?"

        $ Becky.mark_store_orgasm_today()
    return
