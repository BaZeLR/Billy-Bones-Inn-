# Melissa's household priorities. World state stays with its existing owners;
# these labels own only the conversation and the one-time milestone scene.

label MelissaHouseholdPriorities:
    $ renpy.dynamic("_melissa_comfort", "_melissa_comfort_text")
    $ main_ui_begin_native_scene_state("Что важно Мелиссе")
    vscene "images/melissa/tavern/portrait.png"
    "Вы спрашиваете Мелиссу, что для нее сейчас важнее всего. Она на миг задумывается, потом отвечает спокойно и неожиданно открыто."
    menu:
        "Выслушать":
            pass
    "«Чтобы в доме было тише и ровнее. Чтобы можно было работать без постоянной ругани и чтобы меня не дергали по пустякам. Но еще мне важно знать, что меня здесь слушают, а не просто считают одной из рабочих рук», — говорит Мелисса, поднимая на вас внимательный взгляд."
    menu:
        "Спросить о домашнем уюте":
            pass
    "«Для меня уют — это когда в припасах нет крыс, над кроватью целая крыша, во дворе сухо, нужник не разваливается, а комнату убирают хотя бы раз в неделю. И прачечная с теплой купальней нам бы очень пригодилась»."
    menu:
        "Посмотреть, что уже сделано":
            pass
    python:
        _melissa_comfort = Melissa.comfort_components
        _melissa_comfort_text = (
            "Комфорт Мелиссы: %s.\n"
            "Нет крыс: +%s; комната починена: +%s; двор: +%s; нужник: +%s.\n"
            "Прачечная и купальня: +%s; еженедельная уборка: %+d.\n"
            "Удовлетворенность хозяйством: %s. Пополнение припасов прибавляет к ней два очка."
        ) % (Melissa.comfort, _melissa_comfort["rats"], _melissa_comfort["room"],
             _melissa_comfort["yard"], _melissa_comfort["toilet"],
             _melissa_comfort["bathroom_laundry"], _melissa_comfort["cleaning"],
             Melissa.household_satisfaction)
    "[_melissa_comfort_text]"
    menu:
        "Вернуться к разговору":
            pass
    $ main_ui_end_native_scene_state()
    return

label MelissaStoreroomMilestone:
    $ main_ui_begin_native_scene_state("Мелисса довольна запасами")
    vscene "images/melissa/happy.png"
    "«Я пересчитала наши припасы», — сообщает Мелисса. «Больше ста порций провизии и целых пятьдесят бочонков вина, даже не меньше! Теперь можно не вздрагивать при виде каждого пустого мешка». Она пытается сохранить деловой вид, но улыбка выдает ее прежде, чем она заканчивает фразу."
    menu:
        "Продолжить":
            pass
    "Мелисса подходит ближе и поправляет вам воротник, задержав пальцы на ткани чуть дольше, чем требуется. «Вот такого хозяина приятно благодарить». Она смотрит вам в глаза с неожиданно лукавым выражением и, приподнявшись на носки, оставляет на вашей щеке теплый поцелуй."
    menu:
        "Улыбнуться: «Буду стараться и дальше»":
            "«Только не вздумайте теперь считать поцелуи вместо бочек», — смеется Мелисса. Отступая, она еще на мгновение удерживает вашу руку, словно не спешит возвращаться к делам."
        "Поблагодарить ее за заботу о хозяйстве":
            "«Значит, вы замечаете не только полные полки?» Мелисса довольно улыбается. Ее пальцы легко касаются вашей ладони, и привычный разговор о хозяйстве на мгновение становится совсем личным."
    menu:
        "Вернуться к разговору":
            pass
    $ event_runtime.active_thread.complete()
    $ findAvailableEvents(True)
    $ main_ui_end_native_scene_state()
    return
