# Resident scenes use the ordinary schedule and event gate. Room navigation
# and construction state stay with their existing owners.

label story_clara_drawing_work:
    $ main_ui_begin_native_scene_state("Кларисса за рисунками")
    show screen main_ui
    vscene player_room_image_path("room")
    $ scene_runtime.text = "Кларисса устроилась с бумагой у потайного окошка. Она то смотрит в гостевую, то быстро делает несколько штрихов. Возле локтя лежат уже законченные наброски."
    menu:
        "Спросить о рисунках":
            vscene ClaraStaticData.portrait
            $ scene_runtime.text = "— Для Хордуса, — отвечает Кларисса. — В столице охотно платят за хорошие рисунки. Только не тряси стол, хозяин: одной кляксой можно испортить всё утро."
            menu:
                "Не мешать работе":
                    pass
        "Попробовать поцеловать её":
            vscene ClaraStaticData.portrait
            $ scene_runtime.text = "Кларисса улыбается, но отстраняется, прикрывая лист ладонью. — Я сейчас занята, Стефан. Ты меня отвлекаешь. Дай закончить рисунок, а уж потом поговорим."
            menu:
                "Дать ей закончить":
                    pass
        "Оставить её рисовать":
            pass
    $ main_ui_end_native_scene_state()
    return True


label story_clara_breakfast_banter:
    $ renpy.dynamic("_clara_breakfast_joke", "_clara_breakfast_member")
    $ main_ui_begin_native_scene_state("Кларисса за общим столом")
    show screen main_ui
    vscene tavern_kitchen_breakfast_picture()
    $ _clara_breakfast_joke = procedural_randint(0, 10, "clara_breakfast_banter")
    if _clara_breakfast_joke == 0:
        $ scene_runtime.text = "Кларисса отодвигает кружку. — Один граф явился на маскарад в такой дорогой маске, что никто его не узнал. Пока он не испортил воздух. Тут весь зал дружно воскликнул: «Ваше сиятельство!» Манеры, видите ли, не спрячешь даже под бархатом."
    elif _clara_breakfast_joke == 1:
        $ scene_runtime.text = "— В знатном доме слуга подал суп, держа три пальца в тарелке, — начинает Кларисса. — Барон возмутился. А слуга ему: «Не извольте беспокоиться, ваша милость: тарелка холодная, я вам суп грею!»"
    elif _clara_breakfast_joke == 2:
        $ scene_runtime.text = "— У столичных вельмож удивительные приличия, — замечает Кларисса. — За обедом обсуждают добродетель, на балу танцуют с чужими супругами, а утром требуют наказать прачку за то, что она слишком много знает. Прачка, между прочим, единственная из них работает честно."
    elif _clara_breakfast_joke == 3:
        $ scene_runtime.text = "Кларисса оглядывает стол и заговорщически понижает голос. — Женился один деревенский простак. В первую брачную ночь полез не в ту дырку. Жена ему: «Да не туда же, дурень!» А он, — Кларисса изображает такое искреннее изумление, что уже хочется смеяться, — «Погоди... так у тебя их две?!» Подумал немного и решил: «Ну, мне одной хватит. А запасную можешь отдать попу!» Кларисса прячет улыбку за кружкой. — Вот что значит человек не жадный: и сам пристроился, и о духовенстве позаботился."
    elif _clara_breakfast_joke == 4:
        $ scene_runtime.text = "— Шёл к городу один аббат, толстый-претолстый, — начинает Кларисса и для убедительности разводит руки. — Видит крестьянина и спрашивает: «Сын мой, успею ли я пройти в ворота, пока их не закрыли?» Тот оглядел его с головы до ног: «Да через них целый воз с сеном проходит, святой отец. Неужто вы не пролезете?» Кларисса важно надувает щёки, изображая обиженного аббата, и не выдерживает — сама же прыскает со смеху."
    elif _clara_breakfast_joke == 5:
        $ scene_runtime.text = "Кларисса складывает руки на животе и принимает благочестивый вид. — Один монах так горячо проповедовал против прелюбодеяния, что воскликнул: «Уж лучше бы я соблазнил десять девственниц, чем одну замужнюю женщину!» А прихожане ему хором: «И мы, святой отец! И мы!» Она выдерживает паузу, торжественно кивает и добавляет: — Редко бывает, чтобы пастырь и паства так хорошо друг друга поняли."
    elif _clara_breakfast_joke == 6:
        $ scene_runtime.text = "— Тащит молодой бездельник сетку, в которой шерсть полощут, — рассказывает Кларисса. — Парнишка у дороги спрашивает: «Куда это ты с сеткой?» Тот решил поострить: «К выходу из борделя. Твою мать ловить!» А парнишка даже не смутился: «Ты там получше посмотри — свою тоже найдёшь!» Кларисса смеётся и качает головой. — Пошёл за уловом, а сам в собственную сеть и угодил."
    elif _clara_breakfast_joke == 7:
        $ scene_runtime.text = "— Был плотник Джон, а у него жена Алисон, — начинает Кларисса. — Хитрец Николас напугал Джона вторым Всемирным потопом. Муж спасается от воды, а жена с Николасом наставляет ему рога! Тут под окном появляется ещё один ухажёр, Абсолон, просит поцелуя. Алисон и подставляет ему в окно... задницу. Кларисса вытягивает губы, затем изображает оскорблённое благородство. — Абсолон вернулся уже с раскалённым лемехом. Теперь к окну полез Николас: решил перещеголять Алисон и пукнул, словно гром небесный! А в ответ получил горячим железом по заду. Она разводит руками. — Один ждал потопа, другой — поцелуя, третий — аплодисментов. И каждый получил совсем не то, на что рассчитывал!"
    elif _clara_breakfast_joke == 8:
        $ scene_runtime.text = "Кларисса делает скорбное лицо и протягивает ладонь. — Пришёл жадный монах к больному: «Пожертвуй нашей братии что-нибудь на память!» Больной отвечает: «Есть у меня дар. Только обещай разделить поровну». Монах обещал, полез рукой под одеяло — а больной как пукнет! Теперь задача: как разделить один пук между двенадцатью монахами? Кларисса чертит пальцем круг на столе. — Нашёлся умник: берите колесо с двенадцатью спицами, монаха-сборщика сажайте посередине, братьев расставьте у обода. Пусть дар расходится по спицам: всем поровну, никому не обидно! Она с важностью кивает. — Главное, чтобы казначей по дороге половину не присвоил."
    elif _clara_breakfast_joke == 9:
        $ scene_runtime.text = "— А ещё одному проповеднику показали ад, — говорит Кларисса, будто сообщает городскую новость. — Он огляделся: грешники есть, черти есть, а монахов нигде нет. Обрадовался: «Вот видите, вся наша братия спаслась!» Тогда Сатана поднял хвост, и из его задницы монахи посыпались целым роем! Кларисса выдерживает паузу и невинно хлопает ресницами. — Оказалось, у них просто отдельные покои. Ещё и без платы за отопление!"
    else:
        $ scene_runtime.text = "Кларисса понижает голос, хотя явно хочет, чтобы слышал весь стол. — Застала жена одного писаря за рукоблудием. Он перепугался, но нашёлся: «Репетирую супружескую обязанность!» А жена ему: «Что же ты все репетиции без меня проводишь, а на самом представлении засыпаешь?» Кларисса изображает сокрушённый поклон и смеётся. — Репетиции удались. Главную роль опять отдали подушке!"
    menu:
        "Слушать дальше":
            pass
    $ scene_runtime.text = "Кларисса обводит стол насмешливым взглядом. — Если верить каждому строгому аббату, грязно всё, что доставляет удовольствие. А я скажу: грязь отмывают водой, а не кислой миной. Можно любить жизнь и при этом исправно делать своё дело."
    menu:
        "Продолжить":
            pass
    $ scene_runtime.text = "— И хватит проводить каждый свободный час за четырьмя стенами. В воскресенье пойдём к лесному озеру! Возьмём хлеб, сыр, плед — и оставим ссоры дома. Кто первым начнёт ворчать, тот понесёт корзину обратно."
    menu:
        "Поддержать её настроение":
            python:
                for _clara_breakfast_member in tavern_breakfast_present_ids():
                    people.get_info(_clara_breakfast_member).change_mana(1, "clara_breakfast_banter")
            $ scene_runtime.text = "Вы поднимаете кружку за хорошее утро. За столом становится веселее; даже обычные замечания звучат без прежней колкости."
            menu:
                "Вернуться к завтраку":
                    pass
        "Вернуться к завтраку":
            pass
    $ main_ui_end_native_scene_state()
    return True
