define NOSTAR_ROSARIO_PRICE = 1200
define NOSTAR_ROSARIO_ANSWER = "tiefling"

define NOSTAR_ROSARIO_CLUE_PAGES = (
    "Леди разворачивает план мощёной улицы. — С виду всё пристойно: цветные фасады, фонари, тяжёлый бархат за окнами. Но тайны там хранят не хуже, чем драгоценности.\n\nВ пяти домах — шафрановом, лазурном, багряном, цвета слоновой кости и зелёном — живут гномья матрона, полуэльфийка, человеческая госпожа, гоблинская королева и тифлинг-колдунья. У каждой свой напиток, питомец и пристрастие: кожаная плеть-тавза, бархатные ленты, шёлковые шнуры, золотой ошейник или железные кандалы. Среди питомцев есть лиса, лошадь, пара улиток, гончая и мой Розарио — шиншилла, привезённая из Нового Света.\n\n1. Человеческая госпожа живёт в багряном доме.\n2. Гоблинская королева держит гончую.\n3. Кофе пьют в зелёном доме.\n4. Полуэльфийка пьёт чай.\n5. Зелёный дом стоит непосредственно справа от дома цвета слоновой кости.",
    "6. Хозяйка шёлковых шнуров держит пару улиток.\n7. Кожаную тавзу предпочитают в шафрановом доме.\n8. Молоко пьют в среднем доме.\n9. Гномья матрона живёт в первом доме.\n10. Любительница бархатных лент живёт по соседству с владелицей лисы.",
    "11. Дом, где предпочитают кожаную тавзу, соседствует с домом, где держат лошадь.\n12. Хозяйка золотого ошейника пьёт сок севильских апельсинов.\n13. Тифлинг-колдунья предпочитает железные кандалы.\n14. Гномья матрона живёт рядом с лазурным домом.\n\nВода и последний питомец определятся сами, если верно расставить остальных. Кто держит Розарио?",
)


label IntNostarTalk:
    $ Nostar.mark_known()
    $ main_ui_begin_talk_state("Разговор с леди Ностар Линк", "nostar")
    if Sofa.installed:
        $ scene_runtime.text = "— Снова вы, хозяин трактира? — Леди Ностар гладит Розарио за ухом и с удовольствием поглядывает на место, где прежде стоял диван. — Надеюсь, новая мебель не болтает у вас больше, чем здесь."
    else:
        $ scene_runtime.text = "Леди Ностар задерживает взгляд на ваших сапогах, потом на лице. — Полагаю, к моим дверям вас привела не любовь к цветным фасадам. Говорите, хозяин трактира, чем я могу вас удивить?"
    while True:
        $ main_ui_runtime.talk_picture = "images/nostar/lady_nostar_after_sale.png" if Sofa.installed else NostarStaticData.portrait
        menu:
            "Спросить о пропавшей Розарио" if story_event_available("talk_nostar", "rosario_riddle"):
                call checkTriggers("talk_nostar", "rosario_riddle", 0)
            "Спросить о диване" if story_event_available("talk_nostar", "sofa_sale"):
                call checkTriggers("talk_nostar", "sofa_sale", 0)
                vscene nostar_house_picture()
            "Узнать, что случилось с Розарио" if int(threads["nostarRosarioSofa"].num or 0) == 1 and not story_event_available("talk_nostar", "rosario_riddle"):
                $ scene_runtime.text = "— Десятник Циммерман пока не ручается за вашу проницательность, — говорит леди, прикрывая ладонью пустую клетку. — Разберитесь в деле жениха Клариссы Легаре. Когда сумеете отличить улику от удобной сплетни, возвращайтесь: тогда я доверю вам поиски Розарио."
            "Поговорить о квартале":
                $ scene_runtime.text = "— У каждого дома свой цвет, у каждой хозяйки — привычка уверять, будто ей нечего скрывать, — усмехается леди Ностар. — Я бы поверила им охотнее, если бы мой Розарио не пропал на этой самой улице."
            "Закончить разговор":
                $ main_ui_end_talk_state()
                return


label story_nostar_rosario_riddle_1:
    $ renpy.dynamic("_nostar_answer")
    $ main_ui_begin_native_scene_state("Пропажа Розарио")
    show screen main_ui
    vscene "images/nostar/lady_nostar.png"
    $ scene_runtime.text = "— Вы тот самый Стефан? — Леди Ностар откладывает книгу. — Уважаемый десятник Циммерман рассказал, как вы нашли ложь в деле убийства жениха Клариссы Легаре. Весь город судачил о виновных, а вы послушали показания. Мне это нравится.\n\n— Я пришёл спросить о диване для гостевой, леди.\n\n— Ах, о покупке у Папируса. Месяц назад я была от неё в восторге. Теперь этот диван слышит больше, чем мои слуги, и, кажется, не умеет молчать. Но прежде чем говорить о цене, помогите мне с делом посерьёзнее. Мой Розарио пропал. Я уверена, что одна из пяти соседок увела его и держит у себя; скажите, какая. Если окажетесь правы, уступлю диван за тысячу двести мараведи и после расчёта тотчас отправлю его в ваш трактир."
    menu:
        "Взять записи о пяти домах":
            pass
    vscene "images/nostar/nobility_quarters.png"
    $ scene_runtime.text = "На пергаменте пять домов выстроены в ряд. Вы раскладываете приметы по столбцам, сверяясь с записями леди Ностар."
    while True:
        call screen nostar_rosario_worksheet
        if _return != "submit":
            $ main_ui_end_native_scene_state()
            return False
        $ _nostar_answer = Nostar.rosario_answer()
        if _nostar_answer == NOSTAR_ROSARIO_ANSWER:
            vscene "images/nostar/lady_nostar.png"
            $ scene_runtime.text = "— Розарио у тифлинг-колдуньи, в зелёном доме, пятом слева, — отвечаете вы. — Гномья матрона живёт в первом доме, значит, лазурный — второй. Шафрановый с тавзой остаётся первым, а лошадь — во втором. Расставьте напитки, ленты и прочих питомцев: для колдуньи останется только ваша шиншилла.\n\nЛеди Ностар перестаёт улыбаться. Её палец ещё раз пробегает по пяти домам на листе. — Если вы правы, Стефан, сегодня я впервые обрадуюсь тому, что этот диван покинет мою гостиную."
            menu:
                "Выслушать леди Ностар":
                    pass
            $ scene_runtime.text = "Леди посылает слугу к зелёному дому. Тот возвращается не с оправданиями, а с переносной клеткой: Розарио сердито фыркает из-за решётки. Ностар прижимает шиншиллу к груди и наконец позволяет себе рассмеяться.\n\n— Слово держу, Стефан. Тысяча двести мараведи — и мои люди немедленно понесут диван в ваш трактир. Только не возвращайте его мне, если он заговорит по дороге."
            menu:
                "Вернуться к разговору о покупке":
                    pass
            $ event_runtime.active_thread.advance()
            $ main_ui_end_native_scene_state()
            return True
        vscene "images/nostar/lady_nostar.png"
        $ scene_runtime.text = "— Нет, — леди Ностар придерживает лист, прежде чем вы успеваете его свернуть. — Вы ищете Розарио не в том доме. Начните с гномьей матроны в первом и молока в третьем; мои соседи не умеют менять дома местами, даже если им очень хочется."
        menu:
            "Снова изучить записи":
                vscene "images/nostar/nobility_quarters.png"
            "Вернуться позже":
                $ main_ui_end_native_scene_state()
                return False


label story_nostar_sofa_sale_2:
    $ main_ui_begin_native_scene_state("Покупка дивана")
    show screen main_ui
    vscene "images/nostar/lady_nostar.png"
    if int(player.economy.money or 0) < NOSTAR_ROSARIO_PRICE:
        $ scene_runtime.text = "— Розарио дома, и я помню наш уговор, — леди Ностар останавливает взглядом уже потянувшихся к дивану носильщиков. — Тысяча двести мараведи. Принесите деньги, и они сразу отнесут его в ваш трактир. До тех пор мои стены ещё потерпят его разговоры."
        menu:
            "Вернуться к разговору":
                pass
        $ main_ui_end_native_scene_state()
        return False
    $ scene_runtime.text = "Розарио обнюхивает вашу перчатку, а леди Ностар кивает на бордовый диван. — Итак, хозяин: тысяча двести мараведи. Заплатите сейчас — и к вашему возвращению он будет стоять в гостевой. Я даже велю носильщикам нести его бережно, хотя он этого совершенно не заслужил."
    menu:
        "Заплатить 1200 мараведи и заказать доставку":
            $ player.spend_money(NOSTAR_ROSARIO_PRICE)
            $ Sofa.installed = True
            $ event_runtime.active_thread.advance()
            vscene "images/nostar/drawing_room_without_sofa.png"
            $ scene_runtime.text = "Леди пересчитывает деньги, звенит в колокольчик и указывает носильщикам на диван. Те берутся за резные подлокотники; из глубины обивки доносится недовольное ворчание. Розарио прячется у хозяйки на плече.\n\n— Вот и прекрасно, — говорит Ностар. — Пока вы дойдёте до трактира, мои люди установят его в гостевой. И, Стефан... не рассказывайте Папирусу, что мне стало жаль с ним расставаться."
            menu:
                "Вернуться в трактир":
                    pass
            call stat
            $ main_ui_end_native_scene_state()
            return True
        "Пока не покупать":
            $ main_ui_end_native_scene_state()
            return False


label story_nostar_sofa_delivery_3:
    $ main_ui_begin_native_scene_state("Новая гостиная")
    show screen main_ui
    vscene "images/tavern/mainhall/tavern_crew.jpg"
    $ scene_runtime.text = "Вы ещё не успеваете снять плащ, когда в зал входят носильщики леди Ностар. Между ними плывёт огромный бордовый диван. Сандра захлопывает счётную книгу: — Стефан, это и есть новая мебель для гостевой?\n\n— Если они сумеют пронести её мимо дверного косяка, — отвечает Мелисса и спешит указать дорогу. Аманда обходит диван кругом, присвистывает и осторожно трогает резную лапу. — Красавец. Похоже, он обошёлся дороже всех наших стульев вместе взятых."
    menu:
        "Проводить их в гостевую":
            pass
    vscene tavern_empty_room_picture()
    if tavern.renovation_complete("guest_room"):
        $ scene_runtime.text = "В отремонтированной гостевой диван встаёт напротив каменной печи так удачно, будто комнату строили вокруг него. Сандра проводит ладонью по бархатной спинке. — Вот теперь за эту комнату можно просить достойную плату.\n\nАманда опускается на край сиденья и, удивившись его мягкости, смеётся: — Только сперва запишите меня в гости. На такую мебель у хозяина наверняка уже очередь. Мелисса поправляет подушку и признаёт, что впервые ей не хочется немедленно переставить купленную вами вещь."
    else:
        $ scene_runtime.text = "В старой гостевой диван выглядит почти вызывающе роскошным. Сандра любуется резьбой, затем стучит каблуком по скрипучей половице. — Ему бы комнату под стать, Стефан. Иначе гости решат, что мы забыли закончить ремонт.\n\n— Пока вы спорите о стенах, я проверю самое важное, — объявляет Аманда и усаживается на бархат. Мелисса придерживает дверь для носильщиков и невольно улыбается: даже эта неустроенная комната вдруг кажется обещанием чего-то лучшего."
    menu:
        "Выслушать остальных":
            pass
    if Clara.tavern_resident():
        $ scene_runtime.text = "Кларисса приседает перед резной ножкой и шепчет Мелиссе: — Видела? Она только что переступила. Если этот господин умеет рассказывать истории, я принесу бумагу и запишу каждую.\n\nИз-под подушки доносится тяжёлый вздох. Мелисса отступает на шаг, потом упрямо возвращается. — Сначала послушаем вдвоём. Я хочу знать, кого именно ты собралась рисовать."
    else:
        $ scene_runtime.text = "Мелисса присаживается на край дивана, но из глубины обивки раздаётся такой явственный вздох, что она тут же встаёт. — Вы тоже слышали? Надо показать его Клариссе. Она хотя бы сумеет нарисовать то, что здесь прячется.\n\nАманда смеётся, но садиться второй раз уже не спешит."
    menu:
        "Оставить диван на новом месте":
            pass
    $ event_runtime.active_thread.complete()
    $ main_ui_end_native_scene_state()
    return True
