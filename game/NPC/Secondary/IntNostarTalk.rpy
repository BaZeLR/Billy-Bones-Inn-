define NOSTAR_ROSARIO_PRICE = 1200
define NOSTAR_ROSARIO_ANSWER = "tiefling"

define NOSTAR_ROSARIO_CLUE_PAGES = (
    "На улице пять домов: шафрановый, лазурный, багряный, цвета слоновой кости и зелёный. В каждом живёт одна из соседок — гномья матрона, полуэльфийка, человеческая госпожа, гоблинская королева или тифлинг-колдунья. У каждой свой напиток, питомец и любимая принадлежность для приватных забав: кожаная плеть-тавза, бархатные ленты, шёлковые шнуры, золотой ошейник или железные кандалы. Питомцы — лиса, лошадь, пара улиток, гончая и шиншилла Розарио.\n\n1. Человеческая госпожа живёт в багряном доме.\n2. Гоблинская королева держит гончую.\n3. Кофе пьют в зелёном доме.\n4. Полуэльфийка пьёт чай.\n5. Зелёный дом стоит непосредственно справа от дома цвета слоновой кости.",
    "6. Хозяйка шёлковых шнуров держит пару улиток.\n7. Кожаную тавзу предпочитают в шафрановом доме.\n8. Молоко пьют в среднем доме.\n9. Гномья матрона живёт в первом доме.\n10. Любительница бархатных лент живёт по соседству с владелицей лисы.",
    "11. Дом, где предпочитают кожаную тавзу, соседствует с домом, где держат лошадь.\n12. Хозяйка золотого ошейника пьёт сок севильских апельсинов.\n13. Тифлинг-колдунья предпочитает железные кандалы.\n14. Гномья матрона живёт рядом с лазурным домом.\n\nВода и последний питомец определятся сами, если верно расставить остальных. Кто держит Розарио?",
)


label IntNostarTalk:
    $ Nostar.mark_known()
    $ main_ui_begin_talk_state("Разговор с леди Ностар Линк", "nostar")
    $ scene_runtime.text = "Леди Ностар Линк встречает вас с видом человека, которому любопытно, сумеете ли вы сказать хоть что-нибудь неожиданное."
    while True:
        $ main_ui_runtime.talk_picture = "images/nostar/lady_nostar_after_sale.png" if Sofa.installed else NostarStaticData.portrait
        menu:
            "Спросить о пропавшей Розарио" if story_event_available("talk_nostar", "rosario_riddle"):
                call checkTriggers("talk_nostar", "rosario_riddle", 0)
            "Спросить о диване" if story_event_available("talk_nostar", "sofa_sale"):
                call checkTriggers("talk_nostar", "sofa_sale", 0)
                vscene nostar_house_picture()
            "Узнать, что случилось с Розарио" if int(threads["nostarRosarioSofa"].num or 0) == 1 and not story_event_available("talk_nostar", "rosario_riddle"):
                $ scene_runtime.text = "— Циммерман пока не поручился за ваше чутьё, — говорит леди. — Когда распутаете дело Клариссы Легаре и её жениха, возвращайтесь. Тогда я доверю вам загадку Розарио."
            "Поговорить о квартале":
                $ scene_runtime.text = "— Здесь у каждой двери свой цвет и своя тайна, — усмехается леди Ностар. — И не всякая хозяйка рада, когда её тайну находят раньше, чем пропавшую шиншиллу."
            "Закончить разговор":
                $ main_ui_end_talk_state()
                return


label story_nostar_rosario_riddle_1:
    $ renpy.dynamic("_nostar_page", "_nostar_answer")
    $ main_ui_begin_native_scene_state("Пропажа Розарио")
    show screen main_ui
    vscene "images/nostar/lady_nostar.png"
    $ scene_runtime.text = "— Циммерман говорил о вас, хозяин трактира. Говорил, что вы разгадали тайну жениха Клариссы Легаре и заметили ложь там, где его люди увидели только приличные манеры. — Леди Ностар смеётся, но тут же смотрит на пустую клетку. — Тогда испытайте ум ещё раз. Кто-то из соседок унёс моего Розарио. Найдите её, и старинный диван, который я купила у Папируса, станет вашим за скромные тысячу двести мараведи. После расчёта велю доставить его в трактир немедленно."
    menu:
        "Взять записи о пяти домах":
            pass
    vscene "images/nostar/nobility_quarters.png"
    $ _nostar_page = 0
    while True:
        $ scene_runtime.text = NOSTAR_ROSARIO_CLUE_PAGES[_nostar_page]
        menu:
            "Следующая страница" if _nostar_page < 2:
                $ _nostar_page += 1
            "Предыдущая страница" if _nostar_page > 0:
                $ _nostar_page -= 1
            "Назвать соседку":
                menu:
                    "Гномья матрона":
                        $ _nostar_answer = "dwarf"
                    "Полуэльфийка":
                        $ _nostar_answer = "halfelf"
                    "Человеческая госпожа":
                        $ _nostar_answer = "human"
                    "Гоблинская королева":
                        $ _nostar_answer = "goblin"
                    "Тифлинг-колдунья":
                        $ _nostar_answer = "tiefling"
                    "Вернуться к приметам":
                        $ _nostar_answer = ""
                if _nostar_answer == NOSTAR_ROSARIO_ANSWER:
                    vscene "images/nostar/lady_nostar.png"
                    $ scene_runtime.text = "— Тифлинг в зелёном доме, пятом слева, — отвечаете вы. — Гномья матрона живёт в первом, рядом с лазурным; шафрановый дом с тавзой остаётся первым, а лошадь — во втором. Если сопоставить напитки, ленты и питомцев, у колдуньи остаётся только Розарио."
                    menu:
                        "Выслушать леди Ностар":
                            pass
                    $ scene_runtime.text = "Леди Ностар хлопает в ладони и посылает слугу к зелёному дому. Пока тот бегает через улицу, она уже распоряжается снять с дивана покрывало. Вскоре Розарио возвращается в своей переносной клетке, возмущённо фыркая. — Слово держу, Стефан. Тысяча двести мараведи — и мои люди отправят диван к тебе без промедления."
                    menu:
                        "Вернуться к разговору о покупке":
                            pass
                    $ event_runtime.active_thread.advance()
                    $ main_ui_end_native_scene_state()
                    return True
                elif _nostar_answer != "":
                    $ scene_runtime.text = "Леди Ностар качает головой: — Нет. Проверьте соседство домов ещё раз. Розарио не мог просто раствориться между строк."
                    menu:
                        "Снова изучить записи":
                            $ _nostar_page = 0
                        "Вернуться позже":
                            $ main_ui_end_native_scene_state()
                            return False
            "Вернуться позже":
                $ main_ui_end_native_scene_state()
                return False


label story_nostar_sofa_sale_2:
    $ main_ui_begin_native_scene_state("Покупка дивана")
    show screen main_ui
    vscene "images/nostar/lady_nostar.png"
    if int(player.economy.money or 0) < NOSTAR_ROSARIO_PRICE:
        $ scene_runtime.text = "— Я обещала тебе диван, но его цена — тысяча двести мараведи, — напоминает леди Ностар. — Приходи с деньгами, и я тотчас отправлю его в твой трактир."
        menu:
            "Вернуться к разговору":
                pass
        $ main_ui_end_native_scene_state()
        return False
    $ scene_runtime.text = "Розарио уже успел обнюхать вашу перчатку, а леди Ностар всё ещё глядит на пустое место, которое оставит её покупка. — Ну что, хозяин? Тысяча двести мараведи, и диван сейчас же понесут в гостевую."
    menu:
        "Заплатить 1200 мараведи и заказать доставку":
            $ player.spend_money(NOSTAR_ROSARIO_PRICE)
            $ Sofa.installed = True
            $ event_runtime.active_thread.advance()
            vscene "images/nostar/drawing_room_without_sofa.png"
            $ scene_runtime.text = "Леди принимает деньги и одним звонком созывает носильщиков. Те осторожно выносят диван из гостиной. Он негромко ворчит, будто прощается с домом, а леди Ностар с облегчением прижимает к себе Розарио. — К вашему возвращению всё будет на месте, — обещает она."
            menu:
                "Вернуться в трактир":
                    pass
            call stat
            $ main_ui_end_native_scene_state()
            return True
        "Пока не покупать":
            $ main_ui_end_native_scene_state()
            return False


label story_nostar_sofa_delivery_3:
    $ main_ui_begin_native_scene_state("Новая гостиная")
    show screen main_ui
    vscene "images/tavern/mainhall/tavern_crew.jpg"
    $ scene_runtime.text = "Едва вы возвращаетесь в трактир, носильщики леди Ностар протискиваются через зал с огромным диваном. Сандра отрывается от своих книг, Аманда присвистывает, а Мелисса уже спешит следом, боясь, как бы резные ножки не задели дверной косяк."
    menu:
        "Проводить их в гостевую":
            pass
    vscene tavern_empty_room_picture()
    if tavern.renovation_complete("guest_room"):
        $ scene_runtime.text = "В недавно отремонтированной гостевой бордовый бархат неожиданно пришёлся к месту. Сандра проводит ладонью по спинке и признаёт, что комната наконец похожа на место, за которое гость согласится заплатить. Аманда пробует мягкое сиденье и шутит, что теперь хозяину придётся записываться к собственному дивану заранее."
    else:
        $ scene_runtime.text = "Диван оказывается на месте даже прежде, чем гостевую успевают толком привести в порядок. Сандра любуется покупкой, но напоминает: стены и пол стоит отремонтировать, чтобы дорогая вещь не пропадала среди старых досок. Аманда уже проверяет, удобно ли сидеть."
    menu:
        "Выслушать остальных":
            pass
    if Clara.tavern_resident():
        $ scene_runtime.text = "Кларисса наклоняется к Мелиссе: — Видела? Лапы будто живые. Если он умеет рассказывать истории, я первая принесу бумагу. Мелисса усмехается, но задерживает взгляд на тёмной обивке дольше, чем хотела бы показать. — Тогда сначала послушаем вдвоём, — отвечает она."
    else:
        $ scene_runtime.text = "Мелисса присаживается на край сиденья и тут же встаёт: из глубины обивки донёсся вздох. — Надо будет показать это Клариссе, — говорит она. — Та наверняка придумает о нём целую историю."
    menu:
        "Оставить диван на новом месте":
            pass
    $ event_runtime.active_thread.complete()
    $ main_ui_end_native_scene_state()
    return True
